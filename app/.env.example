DATABASE_URL=file:./data/reviewask.db
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
RESEND_FROM=ReviewAsk <onboarding@resend.dev>
# Optional: annual plan price ($390/yr)
STRIPE_PRICE_ID_ANNUAL=

# Protects /api/cron/reminders
CRON_SECRET=
# Public base URL shown for the webhook in Settings
APP_URL=

# Optional: Google Places API (New) key for the dashboard "Your Google reviews" tracker
# (Place Details, field mask rating,userRatingCount). Enable "Places API (New)" and restrict the key to it.
GOOGLE_PLACES_API_KEY=
